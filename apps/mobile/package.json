{
  "name": "@reinder/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.8",
    "@react-navigation/native": "^7.2.1",
    "@reinder/shared": "workspace:*",
    "@supabase/supabase-js": "^2.99.2",
    "expo": "57.0.0-preview.1",
    "expo-auth-session": "^57.0.0",
    "expo-blur": "~57.0.0",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-web-browser": "^57.0.0",
    "nativewind": "^4.2.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-css-interop": "0.2.3",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "^4.5.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!.pnpm|react-native|@react-native|expo|@expo|nativewind|tailwindcss|@testing-library|react-native-gesture-handler)"
    ],
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/__mocks__/react-native-reanimated.js",
      "^@reinder/shared/(.*)$": "<rootDir>/../../packages/shared/src/$1",
      "^@reinder/shared$": "<rootDir>/../../packages/shared/src/index.ts"
    }
  },
  "private": true
}
